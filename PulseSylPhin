local function translateText(originalText)
    if not originalText or originalText == "" then return originalText end
    if Translations[originalText] then return Translations[originalText] end
    local translated = originalText
    for eng, vie in pairs(Translations) do
        if string.find(translated, eng, 1, true) then
            translated = string.gsub(translated, eng, vie)
        end
    end
    return translated
end

local function applyTranslation(inst)
    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        local currentText = inst.Text
        local newText = translateText(currentText)
        if newText ~= currentText then inst.Text = newText end
        inst:GetPropertyChangedSignal("Text"):Connect(function()
            local textNow = inst.Text
            local translatedNow = translateText(textNow)
            if translatedNow ~= textNow then inst.Text = translatedNow end
        end)
    end
end

-- Kích hoạt bộ quét và chuyển đổi ngôn ngữ
for _, child in ipairs(CoreGui:GetDescendants()) do applyTranslation(child) end
if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
    for _, child in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do applyTranslation(child) end
end
CoreGui.DescendantAdded:Connect(applyTranslation)
if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
    LocalPlayer.PlayerGui.DescendantAdded:Connect(applyTranslation)
end

